/* src/index.css */
:root {
  --bg: #f3f6f4;
  --panel: #ffffff;
  --panel-alt: #eef2ef;
  --text: #24302a;
  --muted: #6b7a72;
  --accent: #2f8f5b;
  --accent-hover: #26784c;
  --border: #d4ddd7;
  --danger: #c45c4a;
  --ok: #2f8f5b;
  --paper: #ffffff;
  --ink: #24302a;
  font-family:
    "Segoe UI",
    system-ui,
    sans-serif;
  color: var(--text);
  background: var(--bg);
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  background: var(--bg);
}
a {
  color: inherit;
  text-decoration: none;
}
button {
  font: inherit;
}
.app-shell {
  display: grid;
  grid-template-columns: 248px 1fr;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
}
.sidebar {
  display: flex;
  flex-direction: column;
  height: 100vh;
  max-height: 100vh;
  overflow: hidden;
  position: sticky;
  top: 0;
  background: #1c2430;
  padding: 1.35rem 0.9rem;
  color: #e8eef4;
}
.brand {
  font-weight: 700;
  letter-spacing: 0.02em;
  margin: 0.2rem 0.55rem 1.4rem;
  color: #ffffff;
  font-size: 1.45rem;
  line-height: 1.1;
}
.brand-kicker {
  display: block;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-size: 0.68rem;
  color: #3dba73;
  margin-bottom: 0.2rem;
}
.nav {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 0.15rem;
  scrollbar-width: thin;
  scrollbar-color: #3d4a5a transparent;
}
.nav-inicio {
  margin-bottom: 0.35rem;
}
.nav-group {
  margin-bottom: 0.15rem;
}
.nav-group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.42rem 0.75rem;
  margin-bottom: 0.15rem;
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #8a96a3;
  background: transparent;
  border: none;
  cursor: pointer;
  border-radius: 8px;
  transition: color 0.15s, background 0.15s;
}
.nav-group-title:hover {
  color: #d5dde6;
  background: rgba(255, 255, 255, 0.04);
}
.nav-group.activo .nav-group-title {
  color: #3dba73;
}
.nav-group-chevron {
  width: 0.85rem;
  height: 0.85rem;
  flex-shrink: 0;
  transition: transform 0.2s ease;
  opacity: 0.75;
}
.nav-group-chevron.abierto {
  transform: rotate(90deg);
}
.nav-group-items {
  display: flex;
  flex-direction: column;
  gap: 0.22rem;
  padding-left: 0.15rem;
  border-left: 1px solid rgba(255, 255, 255, 0.08);
  margin-left: 0.55rem;
}
.nav-group.cerrado .nav-group-items {
  display: none;
}
.nav-group-items .nav-icon {
  width: 16px;
  height: 16px;
}
.nav-group-items a {
  padding: 0.58rem 0.75rem;
  font-size: 0.92rem;
}
.nav a {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  padding: 0.68rem 0.85rem;
  border-radius: 10px;
  color: #b7c2ce;
}
.nav-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}
.nav a.active,
.nav a:hover {
  background: #2f8f5b;
  color: #ffffff;
}
.nav-label {
  flex: 1;
  min-width: 0;
}
.nav-group-meta {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.nav-badge {
  flex-shrink: 0;
  min-width: 1.3rem;
  padding: 0.05rem 0.35rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.14);
  color: #f2f6fa;
  font-size: 0.7rem;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
  letter-spacing: 0;
}
.nav-badge.critica {
  background: #d8452f;
  color: #fff;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin: -0.4rem 0 1.1rem;
}
.breadcrumbs {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem;
  font-size: 0.86rem;
  color: var(--muted);
}
.breadcrumbs a {
  color: var(--muted);
  text-decoration: none;
}
.breadcrumbs a:hover {
  color: #2f8f5b;
  text-decoration: underline;
}
.breadcrumb-sep {
  opacity: 0.45;
}
.breadcrumb-eje {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.72rem;
  font-weight: 700;
  color: #6d7c8b;
}
.breadcrumb-actual {
  color: #1c2430;
  font-weight: 600;
}
.alertas-menu {
  position: relative;
}
.alertas-trigger {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.35rem;
  height: 2.35rem;
  border-radius: 12px;
  border: 1px solid #d8dfe5;
  background: #fff;
  color: #566372;
  cursor: pointer;
  transition:
    border-color 0.15s,
    color 0.15s,
    box-shadow 0.15s;
}
.alertas-trigger:hover {
  border-color: #2f8f5b;
  color: #2f8f5b;
}
.alertas-trigger.con-avisos {
  color: #b5761c;
  border-color: #e6c893;
}
.alertas-trigger.critica {
  color: #b8341f;
  border-color: #eab3a8;
  box-shadow: 0 0 0 3px rgba(216, 69, 47, 0.12);
}
.alertas-trigger-icon {
  width: 20px;
  height: 20px;
}
.alertas-trigger-count {
  position: absolute;
  top: -0.35rem;
  right: -0.35rem;
  min-width: 1.15rem;
  padding: 0 0.25rem;
  border-radius: 999px;
  background: #d8452f;
  color: #fff;
  font-size: 0.68rem;
  font-weight: 700;
  line-height: 1.15rem;
  text-align: center;
}
.alertas-panel {
  position: absolute;
  right: 0;
  top: calc(100% + 0.5rem);
  width: 22rem;
  max-height: 26rem;
  overflow-y: auto;
  padding: 0.9rem;
  z-index: 40;
  box-shadow: 0 18px 40px rgba(28, 36, 48, 0.18);
}
.alertas-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.6rem;
  margin-bottom: 0.7rem;
}
.alertas-panel-head small {
  display: block;
  color: var(--muted);
}
.alertas-lista {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}
.alerta-item a {
  display: block;
  padding: 0.6rem 0.7rem;
  border-radius: 10px;
  border-left: 3px solid #cbd4dc;
  background: #f6f8fa;
  color: #1c2430;
  text-decoration: none;
}
.alerta-item a:hover {
  background: #eef2f4;
}
.alerta-item.critica a {
  border-left-color: #d8452f;
}
.alerta-item.aviso a {
  border-left-color: #e0a03c;
}
.alerta-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
}
.alerta-item-cantidad {
  min-width: 1.4rem;
  padding: 0 0.35rem;
  border-radius: 999px;
  background: #e3e9ee;
  font-size: 0.74rem;
  font-weight: 700;
  text-align: center;
}
.alerta-item.critica .alerta-item-cantidad {
  background: #f8ddd8;
  color: #a52f1c;
}
.alerta-item small {
  color: var(--muted);
}
.content {
  padding: 1.6rem 2rem 2rem;
  background: #eef2f4;
  height: 100vh;
  overflow-y: auto;
  min-height: 0;
}
.content-pos {
  padding: 1rem 1.25rem 1.5rem;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  overflow: hidden;
}
.app-shell-pos .content-pos {
  padding-bottom: 0.75rem;
}
.app-shell-pos {
  height: 100vh;
  overflow: hidden;
}
.app-shell-pos .content-pos {
  overflow: hidden;
}
.page-header h1 {
  margin: 0 0 0.35rem;
}
.page-header p {
  margin: 0 0 1.5rem;
  color: var(--muted);
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1rem;
}
.card {
  background: var(--panel);
  border: 0;
  border-radius: 16px;
  padding: 1.15rem 1.2rem;
  box-shadow: 0 8px 24px #1c243014;
}
.card h3 {
  margin: 0 0 0.85rem;
  color: var(--accent);
}
.dash-stack {
  display: grid;
  gap: 1rem;
}
.kpi-value {
  margin: 0;
  font-size: 1.65rem;
  font-weight: 700;
  line-height: 1.15;
}
.kpi-value.kpi-neg {
  color: var(--danger);
}
.kpi-meta {
  margin: 0.4rem 0 0;
  color: var(--muted);
  font-size: 0.88rem;
}
.pos-page {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  min-height: 0;
  flex: 1;
}
.pos-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 400px;
  gap: 1rem;
  align-items: stretch;
  min-height: 0;
  flex: 1;
}
.pos-top {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  gap: 1rem;
  align-items: center;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1rem 1.15rem;
  box-shadow: 0 8px 24px #24302a0a;
}
.pos-title-block h1 {
  margin: 0.1rem 0 0;
  font-size: 1.45rem;
}
.pos-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(110px, 1fr));
  gap: 0.55rem;
}
.pos-stat {
  background: var(--panel-alt);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0.55rem 0.7rem;
  display: flex;
  flex-direction: column;
  gap: 0.08rem;
}
.pos-stat span {
  font-size: 0.72rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.pos-stat strong {
  font-size: 0.98rem;
  line-height: 1.2;
}
.pos-stat small {
  font-size: 0.75rem;
  color: var(--muted);
}
.pos-stat.accent {
  background: #e7f4ec;
  border-color: #b8dcc8;
}
.pos-stat.accent strong {
  color: var(--accent);
}
.pos-stat.ok {
  background: #e7f4ec;
  border-color: #b8dcc8;
}
.pos-stat.warn {
  background: #fdecec;
  border-color: #f0c4bc;
}
.pos-stat.warn strong {
  color: var(--danger);
}
.pos-alert {
  margin: 0;
  padding: 0.65rem 0.9rem;
  border-radius: 10px;
  background: #fdecec;
  border: 1px solid #f0c4bc;
  color: var(--danger);
  font-size: 0.92rem;
}
.pos-catalog-panel {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  min-height: 0;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1rem;
  box-shadow: 0 8px 24px #24302a0a;
  overflow: hidden;
}
.pos-catalog-meta {
  margin: 0;
  font-size: 0.82rem;
  color: var(--muted);
}
.pos-search {
  width: 100%;
}
.pos-checkout {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  min-height: 0;
  max-height: calc(100vh - 9.5rem);
}
.pos-cart,
.pos-pay {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  box-shadow: 0 8px 24px #24302a0a;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.pos-cart {
  flex: 1 1 42%;
}
.pos-pay {
  flex: 1 1 58%;
}
.pos-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.95rem 1rem 0.7rem;
  border-bottom: 1px solid var(--border);
}
.pos-panel-head h3 {
  margin: 0.15rem 0 0;
  font-size: 1.05rem;
}
.pos-badge {
  background: var(--panel-alt);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 0.2rem 0.55rem;
  font-size: 0.75rem;
  color: var(--muted);
  white-space: nowrap;
}
.pos-cart-body,
.pos-pay-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0.75rem 1rem;
}
.pos-empty {
  text-align: center;
  padding: 1.5rem 0.5rem;
  color: var(--muted);
}
.pos-empty-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  margin-bottom: 0.45rem;
}
.pos-empty strong {
  display: block;
  color: var(--text);
  margin-bottom: 0.25rem;
}
.pos-empty p {
  margin: 0;
  font-size: 0.88rem;
}
.cart-line {
  padding: 0.65rem 0;
  border-bottom: 1px dashed var(--border);
}
.cart-line:last-child {
  border-bottom: 0;
}
.cart-line-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 0.45rem;
}
.cart-line-price {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.15rem;
}
.pos-totals {
  margin: 0;
  padding: 0.75rem 1rem 0.95rem;
  border-top: 1px solid var(--border);
  background: #fafbfa;
  border-radius: 0 0 16px 16px;
}
.pos-totals > div {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin: 0.18rem 0;
  font-size: 0.92rem;
}
.pos-totals dt {
  color: var(--muted);
}
.pos-totals dd {
  margin: 0;
  font-weight: 600;
}
.pos-total-row {
  margin-top: 0.35rem !important;
  padding-top: 0.35rem;
  border-top: 1px dashed var(--border);
  font-size: 1.05rem !important;
}
.pos-total-row dt,
.pos-total-row dd {
  font-weight: 800 !important;
  color: var(--text);
}
.pos-pay-foot {
  padding: 0.85rem 1rem 1rem;
  border-top: 1px solid var(--border);
}
.pos-pay-foot .btn {
  width: 100%;
  padding: 0.75rem 1rem;
  font-size: 1rem;
}
.pay-block {
  background: var(--panel-alt);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0.75rem;
  margin-bottom: 0.65rem;
}
.pay-block:last-child {
  margin-bottom: 0;
}
.pay-block-title {
  margin: 0 0 0.55rem;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 700;
}
.pay-field {
  display: flex;
  flex-direction: column;
  gap: 0.28rem;
  margin-bottom: 0.55rem;
}
.pay-field:last-child {
  margin-bottom: 0;
}
.pay-field span {
  font-size: 0.82rem;
  color: var(--muted);
}
.pay-field input,
.pay-field select {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.5rem 0.65rem;
  background: #fff;
  color: var(--text);
}
.pay-field-lg input {
  font-size: 1.15rem;
  font-weight: 700;
  padding: 0.65rem 0.75rem;
}
.pay-segment {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.45rem;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 0.25rem;
}
.pay-segment-btn {
  border: 0;
  background: transparent;
  border-radius: 8px;
  padding: 0.55rem 0.65rem;
  cursor: pointer;
  font-weight: 600;
  color: var(--muted);
}
.pay-segment-btn.active {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 4px 12px #2f8f5b33;
}
.pay-change-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 0.65rem 0.75rem;
  border-radius: 10px;
  background: #e7f4ec;
  margin-top: 0.45rem;
}
.pay-change-box strong {
  font-size: 1.15rem;
  color: var(--accent);
}
.pay-change-box.warn {
  background: #fde8e8;
}
.pay-change-box.warn strong {
  color: var(--danger);
}
.pay-change-box.neutral {
  background: #eef2f4;
}
.pay-change-box.neutral strong {
  color: var(--text);
}
.pay-note {
  margin: 0.45rem 0 0;
  font-size: 0.82rem;
  color: var(--muted);
}
.pay-note.warn {
  color: var(--danger);
}
.pay-block-age {
  background: #f4faf6;
  border-color: #c8e6d4;
}
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: #1c2430a8;
  backdrop-filter: blur(4px);
  display: grid;
  place-items: center;
  padding: 1rem;
  animation: modal-fade 0.18s ease;
}
@keyframes modal-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.modal-panel {
  width: min(100%, 520px);
  max-height: min(92vh, 720px);
  background: var(--panel);
  border-radius: 18px;
  border: 1px solid var(--border);
  box-shadow: 0 24px 60px #1c243040;
  display: flex;
  flex-direction: column;
  animation: modal-rise 0.22s ease;
}
@keyframes modal-rise {
  from {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
.modal-sm {
  width: min(100%, 420px);
}
.modal-md {
  width: min(100%, 520px);
}
.modal-lg {
  width: min(100%, 720px);
  max-height: min(92vh, 820px);
}
.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.1rem 1.15rem 0.85rem;
  border-bottom: 1px solid var(--border);
}
.modal-head-text h2 {
  margin: 0.15rem 0 0;
  font-size: 1.25rem;
}
.modal-close {
  width: 2rem;
  height: 2rem;
  border: 0;
  border-radius: 8px;
  background: var(--panel-alt);
  color: var(--muted);
  font-size: 1.35rem;
  line-height: 1;
  cursor: pointer;
}
.modal-close:hover {
  background: #eef2f4;
  color: var(--text);
}
.modal-body {
  padding: 1rem 1.15rem;
  overflow-y: auto;
}
.modal-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 0.55rem;
  flex-wrap: wrap;
  padding: 0.85rem 1.15rem 1.1rem;
  border-top: 1px solid var(--border);
  background: #fafbfa;
  border-radius: 0 0 18px 18px;
}
.modal-footer .hint {
  flex: 1;
  min-width: 12rem;
  margin: 0;
  text-align: left;
}
.receipt-modal {
  text-align: center;
}
.receipt-success {
  width: 3rem;
  height: 3rem;
  margin: 0 auto 0.75rem;
  border-radius: 50%;
  background: #e7f4ec;
  color: var(--accent);
  display: grid;
  place-items: center;
}
.receipt-meta {
  margin: 0 0 0.85rem;
  color: var(--muted);
  font-size: 0.9rem;
}
.receipt-lines {
  list-style: none;
  margin: 0 0 0.75rem;
  padding: 0;
  text-align: left;
  border: 1px dashed var(--border);
  border-radius: 12px;
  overflow: hidden;
}
.receipt-lines li {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.55rem 0.75rem;
  border-bottom: 1px dashed var(--border);
  font-size: 0.92rem;
}
.receipt-lines li:last-child {
  border-bottom: 0;
}
.receipt-totals {
  border-radius: 12px;
  text-align: left;
}
.receipt-cash-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.55rem;
  margin-top: 0.75rem;
}
.receipt-cash-row span {
  background: var(--panel-alt);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 0.55rem 0.65rem;
  font-size: 0.85rem;
  color: var(--muted);
}
.receipt-cash-row strong {
  display: block;
  color: var(--text);
  font-size: 1rem;
