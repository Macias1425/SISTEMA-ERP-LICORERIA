  flex: 1;
  min-height: 0;
  overflow: auto;
}
.pos-ticket-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 280px;
  color: var(--muted);
  font-size: 0.9rem;
}
.pos-ticket-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}
.pos-ticket-table thead th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: #eef2f6;
  color: #5c6b7a;
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-align: left;
  padding: 0.65rem 0.75rem;
  border-bottom: 1px solid var(--border);
}
.pos-ticket-table tbody td {
  padding: 0.55rem 0.75rem;
  border-bottom: 1px solid #eef2f4;
  vertical-align: middle;
}
.pos-ticket-table tbody tr.is-alt {
  background: #fafbfc;
}
.pos-ticket-num,
.pos-ticket-code {
  color: var(--muted);
  font-size: 0.82rem;
  white-space: nowrap;
}
.pos-ticket-desc {
  font-weight: 700;
  text-transform: uppercase;
  max-width: 280px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.pos-ticket-aviso {
  display: block;
  font-weight: 600;
  text-transform: none;
  color: #b8341f;
  font-size: 0.74rem;
  white-space: normal;
}
.pos-escaner-multiplicador {
  padding: 0.1rem 0.45rem;
  border-radius: 999px;
  background: #2f8f5b;
  color: #fff;
  font-size: 0.78rem;
  font-weight: 700;
}
.pos-escaner-feedback {
  position: absolute;
  top: calc(100% + 0.3rem);
  left: 0;
  margin: 0;
  padding: 0.25rem 0.6rem;
  border-radius: 8px;
  font-size: 0.78rem;
  font-weight: 600;
  z-index: 25;
}
.pos-escaner-feedback.ok {
  background: #dcfce7;
  color: #166534;
}
.pos-escaner-feedback.error {
  background: #fee2e2;
  color: #991b1b;
}
.pos-ticket-qty input {
  width: 3.25rem;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.35rem 0.25rem;
  font-weight: 700;
  background: #f3f6f9;
}
.pos-ticket-unit,
.pos-ticket-amount {
  font-weight: 700;
  white-space: nowrap;
}
.pos-ticket-amount {
  color: #1c2430;
}
.pos-ticket-remove {
  width: 2rem;
  height: 2rem;
  border: 0;
  border-radius: 999px;
  background: #fdecec;
  color: var(--danger);
  cursor: pointer;
  display: grid;
  place-items: center;
}
.pos-ticket-remove:hover {
  background: #fbd5d5;
}
.pos-checkout {
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 8px 24px #24302a0a;
}
.pos-checkout-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.35rem;
  padding: 0.55rem;
  background: #eef2f4;
  border-bottom: 1px solid var(--border);
}
.pos-checkout-tab {
  border: 0;
  border-radius: 8px;
  padding: 0.55rem 0.5rem;
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
}
.pos-checkout-tab.active {
  background: #fff;
  color: #1c2430;
  box-shadow: 0 2px 8px #24302a12;
}
.pos-checkout-tab:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.pos-checkout-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}
.pos-checkout-client {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 0.55rem 0.65rem;
  background: #fff;
  color: var(--muted);
}
.pos-checkout-client select,
.pos-checkout-type select,
.pos-checkout-field input {
  width: 100%;
  border: 0;
  background: transparent;
  font-size: 0.92rem;
  color: var(--text);
}
.pos-checkout-client select:focus,
.pos-checkout-type select:focus,
.pos-checkout-field input:focus {
  outline: none;
}
.pos-checkout-type,
.pos-checkout-field {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.pos-checkout-type span,
.pos-checkout-field span {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--muted);
  font-weight: 700;
}
.pos-checkout-type select,
.pos-checkout-field input {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.5rem 0.65rem;
  background: #fff;
}
.pos-checkout-summary {
  background: #f8fafc;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0.75rem;
}
.pos-checkout-summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.88rem;
  color: var(--muted);
  margin-bottom: 0.35rem;
}
.pos-checkout-summary-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 0.75rem;
  padding-top: 0.35rem;
  border-top: 1px dashed var(--border);
}
.pos-checkout-summary-total span {
  font-size: 0.82rem;
  font-weight: 800;
  text-transform: uppercase;
}
.pos-checkout-summary-total strong {
  font-size: 1.45rem;
  color: #1c2430;
}
.pos-checkout-tax {
  margin: 0.35rem 0 0;
  font-size: 0.78rem;
  color: var(--muted);
}
.pos-checkout-methods {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.45rem;
}
.pos-checkout-method {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  border: 2px solid var(--border);
  border-radius: 10px;
  padding: 0.6rem 0.45rem;
  background: #fff;
  font-size: 0.82rem;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--muted);
  cursor: pointer;
}
.pos-checkout-method.active {
  background: #1c2430;
  border-color: #1c2430;
  color: #fff;
}
.pos-checkout-cash {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}
.pos-checkout-exact {
  border: 1px solid var(--border);
  background: #fff;
  border-radius: 8px;
  padding: 0.45rem 0.65rem;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  cursor: pointer;
}
.pos-checkout-exact:hover:not(:disabled) {
  background: #f3f6f9;
}
.pos-checkout-exact:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.pos-checkout-due {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.55rem 0.65rem;
  border-radius: 8px;
  background: #eef2f4;
  font-size: 0.82rem;
}
.pos-checkout-due strong {
  font-size: 1.05rem;
}
.pos-checkout-due.is-short {
  background: #fdecec;
}
.pos-checkout-due.is-short strong {
  color: var(--danger);
}
.pos-checkout-quick {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.35rem;
}
.pos-checkout-quick-btn {
  border: 1px solid var(--border);
  background: #fff;
  border-radius: 8px;
  padding: 0.45rem 0.25rem;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
}
.pos-checkout-quick-btn:hover {
  background: #f3f6f9;
  border-color: #c5ced8;
}
.pos-checkout-card-hint {
  margin: 0;
  font-size: 0.82rem;
  color: var(--muted);
  padding: 0.55rem 0.65rem;
  background: #eef2f4;
  border-radius: 8px;
}
.pos-checkout-age {
  padding: 0.65rem;
  background: #f4faf6;
  border: 1px solid #c8e6d4;
  border-radius: 10px;
}
.pos-checkout-age.is-invalid {
  background: #fdecec;
  border-color: #f0c4bc;
}
.pos-checkout-age h3 {
  margin: 0 0 0.35rem;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--muted);
}
.pos-checkout-age-hint {
  margin: 0 0 0.5rem;
  font-size: 0.8rem;
  color: var(--muted);
}
.pos-checkout-age-error {
  margin: 0 0 0.5rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--danger);
}
.pos-checkout-age-or {
  margin: 0.35rem 0;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  text-align: center;
}
.pos-checkout-age .pos-check {
  margin-bottom: 0;
}
.pos-checkout-alert {
  margin: 0;
  padding: 0.55rem 0.65rem;
  border-radius: 8px;
  background: #fdecec;
  border: 1px solid #f0c4bc;
  color: var(--danger);
  font-size: 0.85rem;
}
.pos-checkout-note {
  margin: 0;
  font-size: 0.82rem;
  color: var(--muted);
}
.pos-checkout-note.warn {
  color: var(--danger);
}
.pos-checkout-foot {
  padding: 0.75rem;
  border-top: 1px solid var(--border);
  background: #fafbfc;
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}
.pos-checkout-pay {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  border: 2px solid #1c2430;
  background: #fff;
  color: #1c2430;
  border-radius: 12px;
  padding: 0.85rem 1rem;
  font-size: 1rem;
  font-weight: 800;
  cursor: pointer;
}
.pos-checkout-pay:hover:not(:disabled) {
  background: #1c2430;
  color: #fff;
}
.pos-checkout-pay:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.pos-checkout-cancel {
  width: 100%;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
}
.pos-catalog-modal {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  min-height: 0;
}
.pos-catalog-modal .pos-product-grid {
  max-height: min(52vh, 520px);
  padding: 0;
}
@media (max-width: 1100px) {
  .pos-main-mock {
    grid-template-columns: 1fr;
  }
  .pos-toolbar-status {
    width: 100%;
    margin-left: 0;
  }
}
@media (max-width: 720px) {
  .pos-ticket-desc {
    max-width: 120px;
  }
  .pos-ticket-table {
    font-size: 0.8rem;
  }
  .pos-checkout-quick {
    grid-template-columns: repeat(2, 1fr);
  }
}
.factura-ticket {
  max-width: 420px;
  margin: 0 auto;
  background: #fff;
  border: 1px dashed var(--border);
  border-radius: 12px;
  padding: 1rem 1.1rem;
  font-size: 0.88rem;
  color: var(--text);
}
.factura-ticket-head {
  text-align: center;
  padding-bottom: 0.75rem;
  border-bottom: 1px dashed var(--border);
  margin-bottom: 0.75rem;
}
.factura-ticket-icon {
  color: var(--accent);
  margin-bottom: 0.35rem;
}
.factura-ticket-business {
  display: block;
  font-size: 1.05rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.factura-ticket-type {
  margin: 0.2rem 0 0;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted);
}
.factura-ticket-num {
  margin: 0.45rem 0 0;
  font-size: 1.15rem;
  font-weight: 800;
